generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource ubiquityWorktimeMonitor {
  provider = "postgresql"
}
model Configuration {
  id    String @id @default(uuid())
  key   String
  value String
}
model Worker {
  id        String  @id @default(uuid())
  name      String
  lastname  String
  email     String?

  workEvents WorkEvent[]
}

model WorkEvent {
  id        String  @id @default(uuid())
  workerId  String  
  type      WorkEventTypes
  timeStart DateTime
  timeEnd   DateTime

  worker    Worker  @relation(fields: [workerId], references: [id])
}

enum WorkEventTypes {
  WORK
  BREAK
}