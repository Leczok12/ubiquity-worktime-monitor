generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource ubiquityWorktimeMonitor {
  provider = "postgresql"
}
model Configuration {
  key   String @id
  value String
  type  String
}
model Worker {
  id        String  @id
  name      String
  lastname  String
  email     String?
  active    Boolean 

  workEvents WorkEvent[]
}

model Group {
  id      String   @id
  name    String
}

model WorkEvent {
  id        String  @id @default(uuid())
  workerId  String  
  type      WorkEventTypes
  timeStart DateTime
  timeEnd   DateTime

  worker    Worker  @relation(fields: [workerId], references: [id])
}

enum WorkEventTypes {
  WORK
  BREAK
}