generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource ubiquityWorktimeMonitor {
  provider = "postgresql"
}
model Configuration {
  key   String @id
  value String
  type  String
}

model Log {
  id        String   @id @default(uuid())
  date      DateTime
  level     String
  message   String
}
model User {
  id                 String     @id @default(uuid())
  email              String     @unique
  password           String
  name               String
  lastname           String
  lastLogin          DateTime?  
  lastPasswordChange DateTime   @default(now())
  isPasswordChange   Boolean    @default(false)
  isLocked           Boolean    @default(false)
  role               UserRole   @default(WORKER)

  modifiedWorkEvents WorkEvent[]
}

enum UserRole {
  SYSTEM_ADMIN
  MANAGER
  VIEWER
  WORKER
}

model Worker {
  id        String  @id
  name      String
  lastname  String
  email     String?
  active    Boolean 
  sync      Boolean @default(true)

  events    Event[]
  groups    Group[] @relation("WorkerGroups")
  workEvents WorkEvent[]
}

model Group {
  id        String  @id
  name      String
  sync      Boolean @default(true)

  workers Worker[] @relation("WorkerGroups")
}

model Device {
  id   String @id
  name String
  type DeviceType @default(WORK_START_STOP)

  events Event[]
}

enum DeviceType {
  WORK_START_STOP
  BREAK_START
  BREAK_STOP
  UNUSED
}

model Event {
  id          String          @id @default(uuid())
  deviceId    String
  workerId    String
  date        DateTime

  worker    Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)
  device      Device  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

model WorkEvent {
  id          String          @id @default(uuid())
  workerId    String
  lastModifiedByUserId String?
  lastModified DateTime       
  type        WorkEventType
  timeStart   DateTime
  timeEnd     DateTime
  placeStart  String? 
  placeEnd    String?
  isDeleted   Boolean         @default(false)

  lastModifiedByUser User? @relation(fields: [lastModifiedByUserId], references: [id], onUpdate: Cascade)
  worker    Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)
}

enum WorkEventType {
  WORK
  BREAK
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}