{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "lib": ["ES2020"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "./dist",
        "baseUrl": ".",
        "paths": {
            "@shared/*": ["../types/*"]
        },
        "moduleResolution": "node"
    },
    "include": ["src/**/*", "../types/**/*"],
    "ts-node": {
        "require": ["tsconfig-paths/register"],
        "transpileOnly": true
    }
}
